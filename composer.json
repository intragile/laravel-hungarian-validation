{
    "name": "intragile/laravel-hungarian-validation",
    "description": "Validation, normalisation, formatting and test data for Hungarian identifiers: tax number, EU VAT number, tax ID, TAJ, bank account, IBAN, company registration number and postal code. Magyar azonosítók validálása: adószám, adóazonosító jel, TAJ-szám, bankszámlaszám, IBAN, cégjegyzékszám, irányítószám.",
    "keywords": [
        "laravel",
        "validation",
        "validator",
        "hungary",
        "hungarian",
        "tax-number",
        "vat-number",
        "iban",
        "bank-account",
        "faker",
        "magyar",
        "adószám",
        "adoszam",
        "adóazonosító",
        "adoazonosito",
        "taj",
        "taj-szám",
        "bankszámlaszám",
        "bankszamlaszam",
        "cégjegyzékszám",
        "cegjegyzekszam",
        "irányítószám",
        "iranyitoszam",
        "validáció",
        "validacio"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/intragile/laravel-hungarian-validation",
    "support": {
        "issues": "https://github.com/intragile/laravel-hungarian-validation/issues",
        "source": "https://github.com/intragile/laravel-hungarian-validation",
        "security": "https://github.com/intragile/laravel-hungarian-validation/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "illuminate/validation": "Required for the Laravel validation rules (^12.0|^13.0).",
        "fakerphp/faker": "Required for the Faker provider that generates valid identifiers."
    },
    "conflict": {
        "fakerphp/faker": "<1.23",
        "illuminate/support": "<12.0"
    },
    "autoload": {
        "psr-4": {
            "IntrAgile\\HungarianValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\HungarianValidation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IntrAgile\\HungarianValidation\\Laravel\\HungarianValidationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
